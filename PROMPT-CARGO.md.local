### 2d. Remplacer `save()`, `loadAll()` et `saveAll()` par les versions Firebase :

Trouver et remplacer les fonctions `saveAll()` et `loadAll()` par :

```javascript
let _currentUser = null;
let _firestoreUnsub = null;

function getUserId(){
  return _currentUser ? _currentUser.uid : null;
}

function saveAll(){
  // Backup local
  try{ localStorage.setItem('cargo_sessions_backup', JSON.stringify({sessions, activeSession})); }catch(e){}
  // Firestore sync
  const uid = getUserId();
  if(!uid || !window._firebase) return;
  const { db, doc, setDoc, serverTimestamp } = window._firebase;
  sessions.forEach(function(s){
    setDoc(doc(db, 'cargo_sessions', uid+'_'+s.id), {
      ...s, ownerId: uid, updatedAt: serverTimestamp()
    }).catch(console.error);
  });
}

function loadAll(){
  // Load from backup first (instant display)
  try{
    const d = localStorage.getItem('cargo_sessions_backup');
    if(d){ const p=JSON.parse(d); sessions=p.sessions||[]; activeSession=p.activeSession||null; }
  }catch(e){ sessions=[]; activeSession=null; }
}

function startFirestoreSync(){
  const uid = getUserId();
  if(!uid || !window._firebase) return;
  if(_firestoreUnsub) _firestoreUnsub();
  const { db, collection, query, where, orderBy, onSnapshot } = window._firebase;
  _firestoreUnsub = onSnapshot(
    query(collection(db,'cargo_sessions'), where('ownerId','==',uid), orderBy('updatedAt','desc')),
    function(snap){
      sessions = [];
      snap.forEach(function(d){ sessions.push(d.data()); });
      try{ localStorage.setItem('cargo_sessions_backup', JSON.stringify({sessions, activeSession})); }catch(e){}
      if(!window._firebaseReady) return;
      renderSessions();
    },
    function(err){ console.error('Firestore sync error:', err); }
  );
}

function doSignIn(){
  const { auth, signInWithPopup, provider } = window._firebase;
  signInWithPopup(auth, provider).catch(console.error);
}

function doSignOut(){
  if(_firestoreUnsub){ _firestoreUnsub(); _firestoreUnsub=null; }
  const { auth, signOut } = window._firebase;
  signOut(auth).then(function(){
    sessions=[]; activeSession=null;
    renderSessions();
  });
}

function deleteSession(id){
  sessions = sessions.filter(function(s){ return s.id!==id; });
  const uid = getUserId();
  if(uid && window._firebase){
    const { db, doc, deleteDoc } = window._firebase;
    deleteDoc(doc(db,'cargo_sessions', uid+'_'+id)).catch(console.error);
  }
  if(activeSession===id) activeSession=null;
  saveAll(); renderSessions();
}
```

### 2e. Ajouter le listener d'authentification — dans la section INIT (fin du script), remplacer :

```javascript
loadAll();
if(!window._firebaseReady) renderSessions();
applyLang();
```

Par :

```javascript
applyLang();

// Auth wall — show until Firebase responds
document.getElementById('auth-wall').style.display='flex';

window.addEventListener('firebase-ready', function(){
  const { auth, onAuthStateChanged } = window._firebase;
  onAuthStateChanged(auth, function(user){
    _currentUser = user;
    const authWall = document.getElementById('auth-wall');
    const authUser = document.getElementById('auth-user');
    const btnSignin = document.getElementById('btn-signin');
    if(user){
      // Logged in
      authWall.style.display = 'none';
      authUser.style.display = 'flex';
      btnSignin.style.display = 'none';
      const avatar = document.getElementById('auth-avatar');
      const name = document.getElementById('auth-name');
      if(avatar) avatar.src = user.photoURL || '';
      if(name) name.textContent = user.displayName || user.email || '';
      loadAll();
      startFirestoreSync();
      if(!activeSession) renderSessions(); else showPage('sessions');
    } else {
      // Not logged in
      authWall.style.display = 'flex';
      authUser.style.display = 'none';
      btnSignin.style.display = 'inline-flex';
      sessions = []; activeSession = null;
    }
  });
});

// Fallback: if Firebase fails to load
setTimeout(function(){
  if(!window._firebase){
    document.getElementById('auth-wall').style.display='none';
    loadAll(); renderSessions();
  }
},3000);
```

